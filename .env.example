# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:  copy .env.example .env
# ค่าที่ต้องแก้ก่อนใช้งานจริงคือ JWT_SECRET, DB_PASSWORD และ SEED_ADMIN_PASSWORD

# ---------- ฐานข้อมูล (ใช้ค่าเดียวกันทั้ง container postgres และ api) ----------
DB_NAME=chokchai
DB_USER=chokchai
DB_PASSWORD=chokchai
DB_PORT=5432

# ---------- พอร์ตที่เปิดออกมาที่เครื่อง ----------
API_PORT=3000
WEB_PORT=8080

# ---------- ความปลอดภัย ----------
# สร้างค่าสุ่มด้วย:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวๆ ก่อนใช้งานจริง
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:8080

# ---------- บัญชีแอดมินเริ่มต้น (สร้างอัตโนมัติตอนรันครั้งแรก) ----------
SEED_ADMIN_EMAIL=admin@chokchai.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ---------- กติกาการจอง ----------
BOOKING_MIN_LEAD_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=365
BOOKING_MAX_GUESTS=30

# ---------- MySQL (ใช้เฉพาะตอนรัน --profile mysql) ----------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
