# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:  copy .env.example .env
# ค่าที่ต้องแก้ก่อนใช้งานจริงคือ JWT_SECRET, DB_PASSWORD และ SEED_ADMIN_PASSWORD

# ---------- ฐานข้อมูล (ใช้ค่าเดียวกันทั้ง container postgres และ api) ----------
DB_NAME=chokchai
DB_USER=chokchai
DB_PASSWORD=chokchai
DB_PORT=5432

# ---------- พอร์ตที่เปิดออกมาที่เครื่อง ----------
API_PORT=3000
WEB_PORT=8080

# ---------- ความปลอดภัย ----------
# สร้างค่าสุ่มด้วย:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวๆ ก่อนใช้งานจริง
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:8080

# ---------- URL ของเว็บ ----------
# ใช้สร้างลิงก์ในอีเมลและหน้ากลับจากการชำระเงิน — ตอนขึ้นใช้งานจริงเปลี่ยนเป็น https://โดเมนของคุณ
APP_URL=http://localhost:8080

# ---------- การชำระเงิน ----------
# mock   = หน้าชำระเงินจำลอง ไม่ตัดเงินจริง (สำหรับ dev / เดโม)
# stripe = Stripe Checkout ของจริง ต้องใส่คีย์ด้านล่าง
# none   = ปิดชำระออนไลน์ ทีมงานติดต่อกลับแล้วบันทึกรับเงินเองในหน้าหลังบ้าน
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# ได้จากหน้า Webhooks ของ Stripe หลังเพิ่ม endpoint  <APP_URL>/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------- อีเมล ----------
# ค่าเริ่มต้นส่งเข้า Mailpit (เปิดดูที่ http://localhost:8025) ไม่มีอีเมลออกไปหาลูกค้าจริง
# ตอนใช้งานจริงให้ใส่ SMTP ของผู้ให้บริการ เช่น SendGrid: smtp.sendgrid.net / 587 / apikey / <API key>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chokchai Elephant Camp <no-reply@chokchai.local>
MAILPIT_PORT=8025

# ---------- บัญชีแอดมินเริ่มต้น (สร้างอัตโนมัติตอนรันครั้งแรก) ----------
SEED_ADMIN_EMAIL=admin@chokchai.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ---------- กติกาการจอง ----------
BOOKING_MIN_LEAD_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=365
BOOKING_MAX_GUESTS=30

# ---------- MySQL (ใช้เฉพาะตอนรัน --profile mysql) ----------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
