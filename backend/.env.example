# ใช้เฉพาะตอนรัน backend นอก Docker (npm run dev)
# ถ้ารันผ่าน docker compose ค่าจะมาจาก .env ที่ root ของโปรเจกต์แทน
#
#   copy .env.example .env

NODE_ENV=development
PORT=3000

# postgres หรือ mysql
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=chokchai
DB_PASSWORD=chokchai
DB_NAME=chokchai

JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=8h

# ตอน dev มักเปิด frontend ผ่าน Live Server ที่พอร์ต 5500 จึงใส่ไว้ให้ด้วย
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500

SEED_ADMIN_EMAIL=admin@chokchai.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=ผู้ดูแลระบบ

BOOKING_MIN_LEAD_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=365
BOOKING_MAX_GUESTS=30

# ---------- ส่วนที่เพิ่มในเวอร์ชัน 2 ----------
# URL ของหน้าเว็บ ใช้สร้างลิงก์ในอีเมลและหน้ากลับจากการชำระเงิน
APP_URL=http://localhost:8080

# mock = ชำระเงินจำลอง, stripe = Stripe Checkout, none = ปิดชำระออนไลน์
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# เว้น SMTP_HOST ว่าง = ไม่ส่งอีเมลจริง แต่ยังบันทึกลงตาราง notifications
# ถ้ารัน docker compose อยู่ ใช้ Mailpit ได้ด้วย SMTP_HOST=localhost และ SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chokchai Elephant Camp <no-reply@chokchai.local>
